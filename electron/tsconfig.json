{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "../dist-electron",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "./**/*.cts"],
  "exclude": ["./**/*.test.ts"]
}
