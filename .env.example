# Buzz has no production environment-variable configuration.
# API keys, hosts, and credentials are entered through the app UI and stored
# encrypted at rest in the Electron user-data directory.

# The two variables below are used only by the deterministic E2E suites in
# development mode. They are optional and documented for contributors.

# Directory that Playwright seeds with synthetic inventory/data.
# TERMINUS_E2E_DATA_DIR=

# Run the Electron E2E suite against an isolated user-data dir.
# TERMINUS_ISOLATED_E2E=1
